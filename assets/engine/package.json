{
  "name": "product-films",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Filmes de produto feitos em codigo: cenas em DOM + GSAP, preview scrubavel e render frame a frame (skill product-film).",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/render.mjs --stills"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide": "^1.66.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "esbuild": true
  }
}

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": { "@product/*": ["../../src/*"] }
  },
  "include": ["src", "scripts/download-plugin.ts", "vite.config.ts"]
}
